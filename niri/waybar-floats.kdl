// Paste inside the root block of ~/.config/niri/rules.kdl

// calcurse calendar: flotante centrado (right-click en reloj)
window-rule {
    match app-id="calcurse-float"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 550; }
}

// GitHub contributions feed (middle-click en ♁)
window-rule {
    match app-id="github-float"
    open-floating true
    default-column-width { fixed 820; }
    default-window-height { fixed 420; }
}

// Weather dashboard (right-click en ♁)
window-rule {
    match app-id="weather-float"
    open-floating true
    default-column-width { fixed 1060; }
    default-window-height { fixed 560; }
}

// Red — el clic del icono wifi va a scripts/wifi-menu.sh, que abre impala (si
// manda iwd) o nm-connection-editor (si manda NetworkManager).
// Las DOS reglas deben existir: el backend puede cambiar, y el rollback a
// NetworkManager tiene que seguir dando una ventana flotante decente.

// impala: TUI de wifi, dentro de kitty --class=impala-tui. Requiere iwd.
window-rule {
    match app-id="impala-tui"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
    default-column-width { fixed 750; }
    default-window-height { fixed 550; }
}

// Bluetooth manager (click en icono bluetooth)
window-rule {
    match app-id="blueman-manager"
    open-floating true
    default-column-width { fixed 550; }
    default-window-height { fixed 400; }
}

// Specula Imperii — dashboard de productividad (middle-click en otium).
// Flotante, centrada y más pequeña que la pantalla; a font_size 9, 1180 px ≈ 160 col.
window-rule {
    match app-id="specula-float"
    open-floating true
    default-column-width { fixed 1180; }
    default-window-height { fixed 640; }
}

// Power — selector de perfiles de power-profiles-daemon + estado de batería
// (left-click en el icono de batería). Ventana pequeña: solo 3 opciones + header.
window-rule {
    match app-id="power-float"
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 230; }
}
